# =================================================================
# POLYMARKET & KALSHI ARBITRAGE BOT - CREDENTIALS CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your secure credentials.
# NEVER commit .env to source control!

# Polymarket CLOB / Wallet Credentials
POLYMARKET_API_KEY="your_polymarket_api_key_here"
POLYMARKET_SECRET="your_polymarket_secret_here"
POLYMARKET_PASSPHRASE="your_polymarket_passphrase_here"
POLYMARKET_PRIVATE_KEY="your_polygon_wallet_private_key_here"

# Kalshi API Credentials (v2 RSA Authentication)
KALSHI_API_KEY_ID="your_kalshi_api_key_id_here"
# Provide EITHER the path to your RSA private key PEM file OR the raw content
KALSHI_PRIVATE_KEY_PATH="path/to/your_kalshi_rsa_key_here.pem"
KALSHI_PRIVATE_KEY_CONTENT=""

# Optional Dashboard Authentication (Recommended for Remote AWS Access)
# If set, accessing http://<ip>:8000 requires entering this username and password
DASHBOARD_USERNAME=""
DASHBOARD_PASSWORD=""
